# Application
APP_ENV=local
APP_PORT=8085
APP_ALLOWED_ORIGINS=http://localhost:3080,http://127.0.0.1:3080,http://localhost:3000,http://127.0.0.1:3000

# Database
DB_HOST=db
DB_PORT=5440
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=tsetmc_options

# Frontend
FRONTEND_PORT=3080

# Crawler settings
CRAWLER_BASE_URL=https://cdn.tsetmc.com/api
CRAWLER_RATE_LIMIT_SECONDS=3.0
CRAWLER_MAX_RETRIES=3
CRAWLER_BACKOFF_FACTOR=1.0
CRAWLER_USER_AGENT=tsetmc-options-platform/0.1 (student project; optick-lab)
CRAWLER_REQUEST_TIMEOUT=10.0
CRAWLER_QUIET_HOURS_START=09:00
CRAWLER_QUIET_HOURS_END=12:30
CRAWLER_QUIET_HOURS_TZ=Asia/Tehran
